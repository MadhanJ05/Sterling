# Public testnet deployment (milestone E). Optional: the local demo needs none of this.
#
# Nothing in this project ever reads a real mainnet key. Do not put one here.
# Use a throwaway wallet that holds nothing but testnet gas.

# Base Sepolia. Verify the current chain id and a working RPC before deploying:
# the values below were correct at the time of writing and are not re-checked by the script.
TESTNET_RPC_URL=https://sepolia.base.org
TESTNET_CHAIN_ID=84532

# Private key of a throwaway deployer that holds Base Sepolia ETH and nothing else.
# The deploy script reads this, never prints it, and never writes it to any artifact.
TESTNET_DEPLOYER_KEY=

# Payment token.
#   leave blank -> the script deploys a fresh MockUSD with an open faucet (recommended for a demo)
#   set an address -> the script uses that ERC-20 instead and deploys no token
TESTNET_PAYMENT_TOKEN=
